{
	"name": "biyori",
	"version": "1.0.0",
	"description": "Biyori Anime Tracker",
	"main": "./out/main/index.js",
	"author": "Venipa",
	"homepage": "https://github.com/Venipa/biyori",
	"scripts": {
		"format": "prettier --write .",
		"lint": "eslint --cache .",
		"typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
		"generate:routes": "tsr generate",
		"typecheck:web": "bun run generate:routes && tsc --noEmit -p tsconfig.web.json --composite false",
		"typecheck": "bun run typecheck:node && bun run typecheck:web",
		"start": "electron-vite preview",
		"dev": "electron-vite dev",
		"build": "bun run typecheck && electron-vite build",
		"postinstall": "electron-builder install-app-deps",
		"db:generate": "drizzle-kit generate",
		"build:unpack": "bun run build && electron-builder --dir",
		"build:win": "bun run build && electron-builder --win --x64",
		"build:mac": "electron-vite build && electron-builder --mac",
		"build:linux": "electron-vite build && electron-builder --linux",
		"release:compile": "bun run typecheck && electron-vite build",
		"release:pack:win": "electron-builder --win --x64"
	},
	"dependencies": {
		"@base-ui/react": "^1.7.0",
		"@better-fetch/fetch": "^1.3.1",
		"@biyori/electron-trpc": "workspace:*",
		"@biyori/recognition": "workspace:*",
		"@biyori/worker": "workspace:*",
		"@electron-toolkit/preload": "^3.0.2",
		"@electron-toolkit/utils": "^4.0.0",
		"@hookform/resolvers": "^5.9.0",
		"@tanstack/react-query": "^5.101.4",
		"@tanstack/react-router": "^1.170.29",
		"@tanstack/react-table": "^8",
		"@trpc/client": "^11.18.0",
		"@trpc/react-query": "^11.18.0",
		"@trpc/server": "^11.18.0",
		"better-sqlite3": "^13.0.3",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cnfast": "^0.1.0",
		"date-fns": "^4.4.0",
		"drizzle-orm": "^0.45.2",
		"electron-conf": "^1.3.0",
		"electron-updater": "^6.3.9",
		"encryption.js": "^2.0.4",
		"lucide-react": "^1.31.0",
		"motion": "^13.1.0",
		"react-hook-form": "^7.85.0",
		"shadcn": "^4.18.0",
		"styled-jsx": "^5.1.7",
		"superjson": "^2.2.6",
		"tailwind-merge": "^3.6.0",
		"tw-animate-css": "^1.4.0",
		"yaml": "^2.9.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@electron-toolkit/eslint-config-prettier": "^3.0.0",
		"@electron-toolkit/eslint-config-ts": "^3.1.0",
		"@electron-toolkit/tsconfig": "^2.0.0",
		"@rolldown/plugin-styled-jsx": "^0.1.3",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/router-cli": "^1.167.30",
		"@tanstack/router-plugin": "^1.168.32",
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "^22.19.1",
		"@types/react": "^19.2.7",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^5.1.1",
		"drizzle-kit": "^0.31.10",
		"electron": "^39.2.6",
		"electron-builder": "^26.0.12",
		"electron-vite": "^5.0.0",
		"eslint": "^9.39.1",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.0.1",
		"eslint-plugin-react-refresh": "^0.4.24",
		"prettier": "^3.7.4",
		"react": "^19.2.1",
		"react-dom": "^19.2.1",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.9.3",
		"vite": "^7.2.6"
	}
}
