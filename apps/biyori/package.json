{
	"name": "biyori",
	"version": "1.0.0",
	"description": "Biyori Anime Tracker",
	"main": "./out/main/index.js",
	"author": "Venipa",
	"homepage": "https://github.com/Venipa/biyori",
	"scripts": {
		"typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
		"generate:routes": "tsr generate",
		"typecheck:web": "bun run generate:routes && tsc --noEmit -p tsconfig.web.json --composite false",
		"typecheck": "bun run typecheck:node && bun run typecheck:web",
		"start": "electron-vite preview",
		"dev": "bun run --bun --cwd ../../packages/hana build && electron-vite dev",
		"build": "bun run typecheck && electron-vite build",
		"build:hana": "bun run --bun --cwd ../../packages/hana build",
		"build:hana:release": "bun run --bun --cwd ../../packages/hana build:release",
		"postinstall": "install-electron",
		"db:generate": "drizzle-kit generate",
		"build:unpack": "bun run build && bun run build:hana:release && electron-builder --dir",
		"build:win": "bun run build && bun run build:hana:release && electron-builder --win --x64",
		"build:mac": "bun run build && bun run build:hana:release && electron-builder --mac --arm64",
		"build:linux": "bun run build && bun run build:hana:release && electron-builder --linux --x64",
		"release:compile": "bun run typecheck && electron-vite build",
		"release:pack:win": "bun run build:hana:release && electron-builder --win --x64",
		"release:pack:mac": "bun run build:hana:release && electron-builder --mac --arm64",
		"release:pack:linux": "bun run build:hana:release && electron-builder --linux --x64"
	},
	"dependencies": {
		"@biyori/electron-trpc": "workspace:*",
		"@biyori/hana": "workspace:*",
		"@biyori/logger": "workspace:*",
		"@biyori/recognition": "workspace:*",
		"@biyori/translations": "workspace:*",
		"@electron-toolkit/preload": "^3.0.2",
		"@electron-toolkit/utils": "^4.0.0",
		"@sentry/electron": "^7.18.0",
		"@trpc/server": "^11.19.0",
		"better-sqlite3": "^13.0.3",
		"drizzle-orm": "^0.45.4",
		"electron-conf": "^1.3.0",
		"electron-updater": "^6.8.11",
		"encryption.js": "^2.0.4",
		"superjson": "^2.2.6",
		"verkit": "^0.5.0",
		"yaml": "^2.9.1",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@base-ui/react": "^1.7.0",
		"@better-fetch/fetch": "^1.3.3",
		"@electron-toolkit/tsconfig": "^2.0.0",
		"@hookform/resolvers": "^5.9.2",
		"@logtape/file": "^2.3.2",
		"@logtape/logtape": "^2.3.2",
		"@mdx-js/mdx": "^3.1.1",
		"@rolldown/plugin-styled-jsx": "^0.1.3",
		"@sentry/vite-plugin": "^5.4.0",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/react-query": "^5.101.4",
		"@tanstack/react-router": "^1.170.29",
		"@tanstack/react-table": "^8",
		"@tanstack/react-virtual": "^3.14.10",
		"@tanstack/router-cli": "^1.167.30",
		"@tanstack/router-plugin": "^1.168.32",
		"@trpc/client": "^11.19.0",
		"@trpc/react-query": "^11.19.0",
		"@types/better-sqlite3": "^9.6.0",
		"@types/mdx": "^2.0.14",
		"@types/node": "^22.19.1",
		"@types/react": "^19.2.7",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^5.1.1",
		"class-variance-authority": "^0.7.1",
		"cn": "^0.5.0",
		"date-fns": "^4.4.0",
		"drizzle-kit": "^0.31.10",
		"electron": "^44.9.3",
		"electron-builder": "^26.18.0",
		"electron-vite": "^5.0.0",
		"lucide-react": "^1.61.0",
		"motion": "^13.5.1",
		"react": "^19.2.1",
		"react-day-picker": "^10.0.1",
		"react-dom": "^19.2.1",
		"react-hook-form": "^7.85.0",
		"remark-gfm": "^4.0.1",
		"shadcn": "^4.18.0",
		"styled-jsx": "^5.1.7",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.3",
		"vite": "^7.3.7"
	}
}
