{
	"extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
	"include": [
		"src/renderer/src/env.d.ts",
		"src/renderer/src/**/*",
		"src/renderer/src/**/*.tsx",
		"src/preload/*.d.ts",
		"src/lib/**/*",
		"src/shared/**/*",
		"src/main/env.d.ts",
		"src/main/router/**/*.ts",
		"src/main/trpc.ts"
	],
	"compilerOptions": {
		"composite": true,
		"skipLibCheck": true,
		"noUnusedLocals": false,
		"noUnusedParameters": false,
		"jsx": "react-jsx",
		"baseUrl": ".",
		"paths": {
			"@/*": ["src/renderer/src/*"],
			"@/mainview/*": ["src/renderer/src/*"],
			"@/lib/*": ["src/lib/*"],
			"@/shared/*": ["src/shared/*"],
			"@renderer/*": ["src/renderer/src/*"],
			"@shared/*": ["src/shared/*"]
		}
	}
}
