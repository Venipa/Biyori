# Copy to `.env.docs.local` for local docs testing:
#   cp .env.docs.local.example .env.docs.local
#
# Loaded by next.config.mjs + scripts/build-pages.mjs.

REPO_OWNER=Venipa
REPO_NAME=biyori
REPO_URL=https://github.com/Venipa/biyori
REPO_TITLE=Biyori
REPO_BRANCH=master
# Optional locally; CI fetches stargazer count into REPO_STARS
# REPO_STARS=0

# Site URL (sets Next basePath from pathname).
# Leave unset for local `next dev` (no basePath: open http://localhost:3000).
# For Pages-shaped local static preview:
#   GITHUB_PAGES=true
#   NEXT_PUBLIC_URL=https://local.pages/biyori
# Or point at real Pages URL:
# NEXT_PUBLIC_URL=https://venipa.github.io/biyori

# Optional: Discord invite used in nav/footer
# DISCORD_URL=

# Optional: raises GitHub API rate limit for releases/changelog fetches
# GITHUB_TOKEN=
