{
  "name": "biyori-app",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --bun --cwd apps/biyori dev",
    "build": "bun run --bun --cwd apps/biyori build",
    "release": "bun run --bun --cwd apps/biyori build:win",
    "release:compile": "bun run --bun --cwd apps/biyori release:compile",
    "release:pack:win": "bun run --bun --cwd apps/biyori release:pack:win",
    "typecheck": "bun --bun --filter \"biyori\" typecheck",
    "docs:dev": "bun run --cwd apps/docs dev",
    "docs:build": "bun run --cwd apps/docs build",
    "docs:build:pages": "bun run --cwd apps/docs build:pages"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@types/bun": "1.4.1",
    "lefthook": "^2.1.12",
    "vite-plugin-svgr": "^5.2.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.14.0",
    "bun": ">=1.4.0"
  },
  "packageManager": "bun@1.4.0"
}