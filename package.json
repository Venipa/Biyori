{
  "name": "biyori-app",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --cwd apps/biyori dev",
    "build": "bun run --cwd apps/biyori build",
    "release": "bun run --cwd apps/biyori build:win",
    "release:compile": "bun run --cwd apps/biyori release:compile",
    "release:pack:win": "bun run --cwd apps/biyori release:pack:win",
    "typecheck": "bun run --cwd apps/biyori typecheck"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "workspaces": ["apps/*", "packages/*"]
}
